{
  "name": "@agentskit/code-review-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "fumadocs-mdx && next build",
    "typecheck": "fumadocs-mdx && tsc --noEmit",
    "cf:build": "CF_STATIC_EXPORT=1 npm run build && node scripts/cloudflare-headers.mjs",
    "cf:deploy": "npm run cf:build && npx -y wrangler@4 deploy"
  },
  "dependencies": {
    "fumadocs-core": "16.15.4",
    "fumadocs-mdx": "15.4.0",
    "fumadocs-ui": "16.15.4",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "tailwindcss": "4.3.3",
    "typescript": "^6.0.3"
  }
}
