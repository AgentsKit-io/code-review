{
  "name": "@agentskit/code-review-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "fumadocs-mdx && next build",
    "typecheck": "fumadocs-mdx && tsc --noEmit",
    "cf:build": "CF_STATIC_EXPORT=1 npm run build && node scripts/cloudflare-headers.mjs",
    "cf:deploy": "npm run cf:build && npx -y wrangler@4 deploy"
  },
  "dependencies": {
    "fumadocs-core": "16.17.7",
    "fumadocs-mdx": "15.4.9",
    "fumadocs-ui": "16.17.7",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "^6.0.3"
  }
}
