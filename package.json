{
  "name": "@agentskit/code-review",
  "version": "0.27.0",
  "type": "module",
  "description": "Provider-agnostic, low-noise AI code review for local development and GitHub Actions.",
  "license": "MIT",
  "bin": {
    "agentskit-review": "dist/src/cli.js",
    "agentskit-review-campaign": "scripts/review-campaign.mjs",
    "agentskit-review-cycle": "scripts/review-cycle.mjs",
    "agentskit-review-harness": "scripts/review-harness.mjs",
    "agentskit-quality": "scripts/evaluate-quality.mjs"
  },
  "exports": {
    ".": "./dist/src/index.js",
    "./config": "./dist/src/public-config.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "AGENTS.md",
    ".pre-commit-hooks.yaml",
    "action.yml",
    "examples/pull-request.yml",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "ROADMAP.md",
    "CHANGELOG.md",
    "doc-bridge.config.json",
    ".doc-bridge/index.json",
    ".doc-bridge/capabilities.json",
    "ecosystem.json",
    "ecosystem-claims.json",
    "llms.txt",
    "llms-full.txt",
    "docs/OPERATIONS.md",
    "docs/provider-compatibility.json",
    "docs/for-agents",
    "docs/plans",
    "docs/assets",
    "docs/adr",
    "docs/baseline-protocol.md",
    "docs/continuous-improvement.md",
    "docs/quality-matrix.md",
    "test/cli-smoke.test.mjs",
    "test/continuous-improvement.test.mjs",
    "test/context-packs.test.mjs",
    "test/documentation.test.mjs",
    "test/release-workflow.test.mjs",
    "scripts/generate-llms-full.mjs",
    "scripts/run-cycle-benchmark.mjs",
    "scripts/capture-quality-baseline.mjs",
    "scripts/evaluate-quality.mjs",
    "scripts/review-harness.mjs",
    "scripts/review-campaign.mjs",
    "scripts/review-cycle.mjs",
    "quality/corpus/default.json",
    "quality/evals/default.json",
    "quality/learning/default.json",
    "test/harness.test.mjs",
    "test/batch-coverage.test.mjs",
    "test/quality-matrix.test.mjs",
    "test/adaptive-verification.test.mjs",
    "test/review-cache.test.mjs",
    "test/budget.test.mjs",
    "test/review-stores.test.mjs",
    "test/review-feedback.test.mjs",
    "test/quality-evals.test.mjs",
    "test/risk-depth.test.mjs",
    "test/quality-matrix-cli.test.mjs",
    "test/fixtures/bin/codex",
    "test/fixtures/review/good.ts",
    "test/fixtures/review/unreviewed.ts"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AgentsKit-io/code-review.git"
  },
  "homepage": "https://github.com/AgentsKit-io/code-review#readme",
  "bugs": "https://github.com/AgentsKit-io/code-review/issues",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "ai-code-review",
    "code-review",
    "github-action",
    "llm",
    "ollama"
  ],
  "scripts": {
    "review": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test --test-concurrency=1 test/*.test.mjs",
    "benchmark:cycle": "npm run build && node scripts/run-cycle-benchmark.mjs",
    "benchmark:baseline": "npm run build && node scripts/capture-quality-baseline.mjs",
    "quality:matrix": "npm run build && node scripts/evaluate-quality.mjs",
    "harness": "npm run build && node scripts/review-harness.mjs",
    "cycle": "npm run build && node scripts/review-cycle.mjs",
    "campaign": "npm run build && node scripts/review-campaign.mjs",
    "docs:full": "node scripts/generate-llms-full.mjs",
    "docs:index": "ak-docs index && npm run docs:full",
    "docs:gate": "ak-docs gate run && ak-docs conformance run documentation-standard-v1 --text && node scripts/generate-llms-full.mjs --check && node --test test/documentation.test.mjs",
    "docs:doctor": "ak-docs doctor --text",
    "changeset": "changeset",
    "version-packages": "changeset version && npm run docs:full && npm run readme:standard:refresh",
    "check": "npm run typecheck && npm run test && npm run docs:gate && node dist/src/cli.js --help && npm run check:readme-standard",
    "prepare": "npm run build",
    "prepack": "npm run build && npm run docs:gate",
    "check:readme-standard": "node scripts/check-readme-standard.mjs",
    "test:readme-standard": "node --test scripts/readme-standard.test.mjs",
    "readme:standard:refresh": "node scripts/refresh-readme-standard.mjs"
  },
  "dependencies": {
    "@agentskit/adapters": "^0.12.2",
    "@agentskit/core": "^1.9.0",
    "@agentskit/ink": "0.10.9",
    "@agentskit/runtime": "^0.7.3",
    "@agentskit/tools": "^0.9.4",
    "esbuild": "^0.25.0",
    "tsx": "^4.23.13",
    "zod": "^3.25.0",
    "zod-to-json-schema": "^3.24.0"
  },
  "optionalDependencies": {
    "@agentskit/doc-bridge": "^1.1.1"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
