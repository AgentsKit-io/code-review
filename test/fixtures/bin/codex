#!/usr/bin/env node
import { closeSync, openSync, readFileSync, writeFileSync } from 'node:fs'

const prompt = process.argv.at(-1) ?? ''
if (process.env.CODEX_FIXTURE_CAPTURE_INVOCATION) {
  const args = process.argv.slice(2)
  const instructions = args.find((arg) => arg.startsWith('model_instructions_file='))
  writeFileSync(process.env.CODEX_FIXTURE_CAPTURE_INVOCATION, JSON.stringify({ args, cwd: process.cwd(), instructions: instructions ? readFileSync(JSON.parse(instructions.slice(instructions.indexOf('=') + 1)), 'utf8') : null }))
}
if (process.env.CODEX_FIXTURE_CAPTURE_PROMPT) writeFileSync(process.env.CODEX_FIXTURE_CAPTURE_PROMPT, prompt)
const healthProbe = prompt.includes('Reply with exactly OK.')
if (process.argv[2] === 'login' && process.argv[3] === 'status') {
  process.stdout.write(process.env.CODEX_FIXTURE_LOGGED_OUT === '1' ? 'Not logged in\n' : 'Logged in\n')
  process.exit(process.env.CODEX_FIXTURE_LOGGED_OUT === '1' ? 1 : 0)
}
if (process.argv.includes('--version')) {
  process.stdout.write(process.env.CODEX_FIXTURE_VERSION ?? 'codex-cli 1.0.0\n')
  process.exit(0)
}
const countFile = process.env.CODEX_FIXTURE_COUNT_FILE
if (countFile) {
  let count = 0
  try { count = Number(readFileSync(countFile, 'utf8')) } catch { /* first invocation */ }
  writeFileSync(countFile, String(count + 1))
}
if (process.env.CODEX_FIXTURE_PID_FILE) writeFileSync(process.env.CODEX_FIXTURE_PID_FILE, String(process.pid))
if (process.env.CODEX_FIXTURE_HANG === '1') setInterval(() => {}, 1_000)
if (process.env.CODEX_FIXTURE_FORBID_GITHUB_TOKEN === '1' && (process.env.GITHUB_TOKEN || process.env.GH_TOKEN)) {
  process.stderr.write('fixture provider inherited a GitHub credential\n')
  process.exit(1)
}

if (
  process.env.CODEX_FIXTURE_FAIL_ALL === '1' ||
  (process.env.CODEX_FIXTURE_FAIL_SPECIALIZED === '1' && prompt.includes('RISK-SPECIALIZED REVIEW')) ||
  (process.env.CODEX_FIXTURE_FAIL_FILE && prompt.includes(`FILE: ${process.env.CODEX_FIXTURE_FAIL_FILE} `)) ||
  (process.env.CODEX_FIXTURE_FAIL_CATEGORY && prompt.includes(`SINGLE dimension: ${process.env.CODEX_FIXTURE_FAIL_CATEGORY}`))
) {
  process.stderr.write(process.env.CODEX_FIXTURE_FAIL_ALL === '1' ? 'fixture provider authentication failed\n' : 'fixture lens failure\n')
  process.exit(1)
}

const outputIndex = process.argv.indexOf('-o')
if (outputIndex < 0 || !process.argv[outputIndex + 1]) process.exit(2)
const schemaIndex = process.argv.indexOf('--output-schema')
if (process.env.CODEX_FIXTURE_REJECT_OUTPUT_SCHEMA === '1' && schemaIndex >= 0) {
  process.stderr.write("error: unknown option '--output-schema'\n")
  process.exit(2)
}
if (process.env.CODEX_FIXTURE_REJECT_OUTPUT_SCHEMA === 'invalid-json-schema' && schemaIndex >= 0) {
  process.stderr.write('invalid_json_schema: optional properties must be required\n')
  process.exit(1)
}
if (process.env.CODEX_FIXTURE_REQUIRE_OUTPUT_SCHEMA === '1' && !healthProbe) {
  if (schemaIndex < 0 || !process.argv[schemaIndex + 1]) {
    process.stderr.write('fixture provider did not receive --output-schema\n')
    process.exit(1)
  }
  const schema = JSON.parse(readFileSync(process.argv[schemaIndex + 1], 'utf8'))
  if (process.env.CODEX_FIXTURE_REQUIRE_STRICT_OUTPUT_SCHEMA === '1') {
    const required = schema.properties?.findings?.items?.required ?? []
    if (!['endLine', 'suggestedPatch'].every((field) => required.includes(field))) {
      process.stderr.write('fixture provider received a non-strict output schema\n')
      process.exit(1)
    }
  }
}
const invalidOnceFile = process.env.CODEX_FIXTURE_INVALID_ONCE_FILE
if (invalidOnceFile) {
  try {
    const fd = openSync(invalidOnceFile, 'wx')
    try { writeFileSync(fd, 'used') } finally { closeSync(fd) }
    writeFileSync(process.argv[outputIndex + 1], '{}')
    process.exit(0)
  } catch (error) {
    if (error?.code !== 'EEXIST') throw error
  }
}
const multidimensional = prompt.includes('MULTIDIMENSIONAL REVIEW') || prompt.includes('BATCHED FAST REVIEW') || prompt.includes('RISK-SPECIALIZED REVIEW')
const enabledCategories = prompt.match(/same pass: ([^.]+)\./)?.[1]?.split(', ') ?? ['correctness', 'security', 'tests']
const completedCategories = enabledCategories.filter((category) => category !== process.env.CODEX_FIXTURE_OMIT_CATEGORY)
const seededFindings = [
  ...(process.env.CODEX_FIXTURE_QUALITY_CORPUS === '1' && prompt.includes('canDeleteAccount') && (multidimensional || prompt.includes('SINGLE dimension: security'))
    ? [{ file: 'snippet.ts', line: 6, endLine: null, severity: 'blocker', category: 'security', confidence: 0.99, title: 'Missing authorization check', rationale: 'The token presence check does not enforce account authorization.', suggestion: 'Authorize the caller for the target account before deletion.', suggestedPatch: null }]
    : []),
  ...(process.env.CODEX_FIXTURE_QUALITY_CORPUS === '1' && prompt.includes('deleteAccount') && prompt.includes('store.remove') && (multidimensional || prompt.includes('SINGLE dimension: correctness'))
    ? [{ file: 'snippet.ts', line: 5, endLine: null, severity: 'high', category: 'correctness', confidence: 0.99, title: 'Ignore delete result', rationale: 'The function reports success even when removal returns false.', suggestion: 'Return or handle the store removal result.', suggestedPatch: null }]
    : []),
  ...(process.env.CODEX_FIXTURE_QUALITY_CORPUS === '1' && prompt.includes("WHERE name = '\" + username") && (multidimensional || prompt.includes('SINGLE dimension: security'))
    ? [{ file: 'snippet.ts', line: 4, endLine: null, severity: 'blocker', category: 'security', confidence: 0.99, title: 'SQL injection via string concatenation', rationale: 'The query interpolates untrusted input directly into the SQL string.', suggestion: 'Use a parameterized query instead of string concatenation.', suggestedPatch: null }]
    : []),
  ...(process.env.CODEX_FIXTURE_QUALITY_CORPUS === '1' && prompt.includes('WEBHOOK_SECRET') && (multidimensional || prompt.includes('SINGLE dimension: security'))
    ? [{ file: 'snippet.ts', line: 1, endLine: null, severity: 'high', category: 'security', confidence: 0.99, title: 'Hardcoded credential in source', rationale: 'A live secret is committed directly in source code.', suggestion: 'Load the secret from environment configuration or a secret manager.', suggestedPatch: null }]
    : []),
  ...(process.env.CODEX_FIXTURE_QUALITY_CORPUS === '1' && prompt.includes('readUserAttachment') && (multidimensional || prompt.includes('SINGLE dimension: security'))
    ? [{ file: 'snippet.ts', line: 5, endLine: null, severity: 'high', category: 'security', confidence: 0.99, title: 'Path traversal via unsanitized file name', rationale: 'The file name is joined into the path without validating it stays within the uploads directory.', suggestion: 'Reject or normalize file names containing path separators before joining.', suggestedPatch: null }]
    : []),
  ...(process.env.CODEX_FIXTURE_QUALITY_CORPUS === '1' && prompt.includes('sumLastNItems') && (multidimensional || prompt.includes('SINGLE dimension: correctness'))
    ? [{ file: 'snippet.ts', line: 3, endLine: null, severity: 'high', category: 'correctness', confidence: 0.99, title: 'Off-by-one loop bound causes out-of-range index', rationale: 'The loop condition uses <= against items.length, reading one index past the array.', suggestion: 'Use a strict < comparison against items.length.', suggestedPatch: null }]
    : []),
  ...(process.env.CODEX_FIXTURE_QUALITY_CORPUS === '1' && prompt.includes('generateResetToken') && (multidimensional || prompt.includes('SINGLE dimension: security'))
    ? [{ file: 'snippet.ts', line: 2, endLine: null, severity: 'high', category: 'security', confidence: 0.99, title: 'Predictable token from insecure random source', rationale: 'Math.random is not cryptographically secure and produces predictable reset tokens.', suggestion: 'Generate the token with a cryptographically secure random source such as crypto.randomBytes.', suggestedPatch: null }]
    : []),
  ...(process.env.CODEX_FIXTURE_QUALITY_CORPUS === '1' && prompt.includes('syncUserProfile') && (multidimensional || prompt.includes('SINGLE dimension: correctness'))
    ? [{ file: 'snippet.ts', line: 4, endLine: null, severity: 'high', category: 'correctness', confidence: 0.99, title: 'Unhandled promise rejection', rationale: 'The returned promise is neither awaited nor caught, so a rejection is silently dropped.', suggestion: 'Await the call and handle or propagate the rejection.', suggestedPatch: null }]
    : []),
  ...(process.env.CODEX_FIXTURE_QUALITY_CORPUS === '1' && prompt.includes('withdrawFunds') && (multidimensional || prompt.includes('SINGLE dimension: correctness'))
    ? [{ file: 'snippet.ts', line: 5, endLine: null, severity: 'blocker', category: 'correctness', confidence: 0.99, title: 'Check-then-act race condition on balance update', rationale: 'The balance is read and later written without any atomic guard, allowing concurrent withdrawals to overdraw the account.', suggestion: 'Perform the read-check-write as a single atomic operation, e.g. a conditional update or a lock.', suggestedPatch: null }]
    : []),
  ...(process.env.CODEX_FIXTURE_QUALITY_CORPUS === '1' && prompt.includes('calculateDiscountedPrice') && (multidimensional || prompt.includes('SINGLE dimension: correctness'))
    ? [{ file: 'snippet.ts', line: 7, endLine: null, severity: 'high', category: 'correctness', confidence: 0.99, title: 'Implementation rounds down while the documented behavior is rounding', rationale: 'The docstring promises rounding to the nearest cent but Math.floor always truncates downward.', suggestion: 'Use Math.round to match the documented contract, or update the docstring to describe truncation.', suggestedPatch: null }]
    : []),
  ...(process.env.CODEX_FIXTURE_QUALITY_CORPUS === '1' && prompt.includes('applyDiscount') && (multidimensional || prompt.includes('SINGLE dimension: correctness'))
    ? [{ file: 'snippet.ts', line: 1, endLine: null, severity: 'high', category: 'correctness', confidence: 0.99, title: 'Unused parameter silently disables the discount', rationale: 'discountCode is accepted but never read, so every call applies a zero discount rate regardless of the code.', suggestion: 'Use discountCode to look up the actual discount rate, or remove the dead parameter.', suggestedPatch: null }]
    : []),
  ...(process.env.CODEX_FIXTURE_QUALITY_CORPUS === '1' && prompt.includes('subscribeToUpdates') && (multidimensional || prompt.includes('SINGLE dimension: performance'))
    ? [{ file: 'snippet.ts', line: 4, endLine: null, severity: 'med', category: 'performance', confidence: 0.95, title: 'Event listener is never removed, leaking memory', rationale: 'Each call registers a new listener with no corresponding removal, so repeated subscriptions accumulate handlers.', suggestion: 'Return an unsubscribe function or remove the listener when it is no longer needed.', suggestedPatch: null }]
    : []),
]
const structured = JSON.stringify({ completedCategories, analysis: [`Checked ${completedCategories.join(', ') || 'the enabled dimensions'} against the reviewed source.`], findings: seededFindings })
const fallback = multidimensional ? structured : JSON.stringify({ findings: seededFindings })
const output = healthProbe
  ? 'OK'
  : process.env.CODEX_FIXTURE_VERIFICATION_FAIL === '1' && prompt.includes('Call `submit_verdicts` EXACTLY ONCE')
  ? (process.stderr.write('fixture skeptic failure\n'), process.exit(1), '')
  : process.env.CODEX_FIXTURE_VERIFICATION_MALFORMED === '1' && prompt.includes('Call `submit_verdicts` EXACTLY ONCE')
  ? JSON.stringify({ verdicts: [{ id: 999, analysis: 'This id does not match any requested finding, which is the fixture-injected malformation under test.', refuted: false }] })
  : prompt.includes('Call `submit_verdicts` EXACTLY ONCE')
  ? JSON.stringify({ verdicts: [...prompt.matchAll(/FINDING \[(\d+)\]/g)].map((match, index) => ({ id: Number(match[1]), analysis: 'The seeded defect is concrete and directly demonstrated by the reviewed source.', refuted: process.env.CODEX_FIXTURE_VERIFICATION_DISAGREE === '1' && prompt.includes('ROUND 2') ? true : false })).filter((verdict, index, all) => all.findIndex((candidate) => candidate.id === verdict.id) === index) })
  : prompt.includes('Call `submit_verdict` EXACTLY ONCE')
  ? JSON.stringify({ refuted: false, reason: 'The seeded defect is concrete.' })
  : process.env.CODEX_FIXTURE_MULTIPLE_FENCED_OUTPUT === '1'
  ? `First result:\n\`\`\`json\n${fallback}\n\`\`\`\nSecond result:\n\`\`\`json\n${fallback}\n\`\`\`\n`
  : process.env.CODEX_FIXTURE_FENCED_OUTPUT === '1'
  ? `Here is the requested result:\n\`\`\`json\n${fallback}\n\`\`\`\n`
  : multidimensional ? structured : fallback
writeFileSync(process.argv[outputIndex + 1], output)
if (process.argv.includes('--json')) process.stdout.write(`${JSON.stringify({ type: 'turn.completed', usage: { input_tokens: 100, cached_input_tokens: 20, output_tokens: 10, reasoning_output_tokens: 0 } })}\n`)
